# App
DEBUG=false
CORS_ORIGINS=["http://localhost:5173"]

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret

# LiteLLM — Provider API Keys
# Default: Google Gemini (free tier, no billing required)
GEMINI_API_KEY=your-gemini-api-key
DEFAULT_MODEL=gemini/gemini-3-flash
FALLBACK_MODEL=gemini/gemini-3.1-flash-lite

# Optional: add more providers as needed
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Supabase Storage
SUPABASE_STORAGE_BUCKET=assets

# Tavily (Research)
TAVILY_API_KEY=tvly-...

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=30

# Agent config
MAX_REACT_ITERATIONS=10
MAX_TOOL_RETRIES=2

# MCP
# Backend's externally reachable URL (used for the OAuth callback redirect URI).
PUBLIC_BASE_URL=http://localhost:8000
# Fernet key for encrypting MCP server secrets at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCP_ENCRYPTION_KEY=
